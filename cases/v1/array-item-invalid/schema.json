{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "order line items",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sku": {
            "type": "string"
          },
          "qty": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "sku",
          "qty"
        ]
      }
    }
  },
  "required": [
    "items"
  ]
}
