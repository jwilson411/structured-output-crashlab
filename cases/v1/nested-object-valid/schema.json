{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "nested user profile",
  "type": "object",
  "properties": {
    "user": {
      "type": "object",
      "properties": {
        "profile": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "age": {
              "type": "integer"
            }
          },
          "required": [
            "name",
            "age"
          ]
        }
      },
      "required": [
        "profile"
      ]
    }
  },
  "required": [
    "user"
  ]
}
