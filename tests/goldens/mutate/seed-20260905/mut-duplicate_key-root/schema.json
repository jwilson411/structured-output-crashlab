{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "order",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "status",
    "quantity",
    "customer",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 8
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "shipped",
        "cancelled"
      ]
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "discount": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 1
    },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "vip": {
          "type": "boolean"
        }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "maxLength": 6
      }
    }
  }
}
