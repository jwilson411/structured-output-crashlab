{
  "description": "Boundary fixtures for the incremental JSON recognizer. Each entry is a fixed chunking, so a failure is reproducible byte for byte. A chunk is either a string (encoded UTF-8) or {\"hex\": \"...\"} for raw bytes that are not valid UTF-8 on their own.",
  "fixtures": [
    {
      "id": "object-split-mid-key",
      "covers": "structural",
      "description": "The chunk boundary falls inside an object key.",
      "chunks": [
        "{\"na",
        "me\": \"ada\"}"
      ],
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      },
      "feed_states": [
        "incomplete",
        "complete"
      ],
      "final_status": "complete",
      "soc1_status": "schema_valid",
      "value": {
        "name": "ada"
      }
    },
    {
      "id": "object-split-mid-string-value",
      "covers": "structural",
